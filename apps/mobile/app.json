{
  "expo": {
    "name": "EduShare",
    "slug": "edushare",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edushare.student"
    },
    "android": {
      "package": "vn.edushare.student"
    },
    "web": {
      "name": "EduShare",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép EduShare chọn ảnh tài liệu để đăng tin.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
