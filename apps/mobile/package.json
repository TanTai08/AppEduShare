{
  "name": "@edushare/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "build:native": "expo export --platform ios --platform android --output-dir dist-native",
    "check:sdk": "expo install --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
