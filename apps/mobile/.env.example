# Web: http://localhost:4000. Android emulator: http://10.0.2.2:4000.
# iPhone/Android thật: http://<IPv4 Wi-Fi máy tính>:4000 (cùng mạng).
# Sau khi sửa: dừng Expo, chạy npm run start -w apps/mobile -- --clear --lan.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Tùy chọn: tile provider được phép sử dụng, đúng attribution/quota của nhà cung cấp.
# EXPO_PUBLIC_MAP_TILE_URL=https://provider.example/{z}/{x}/{y}.png?key=PUBLIC_MAP_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=Attribution theo yêu cầu nhà cung cấp
