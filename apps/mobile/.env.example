# Frontend: đặt file này tại apps/mobile/.env, KHÔNG phải server/.env.
# auto trong phát triển: web → host trình duyệt; Android Emulator → 10.0.2.2;
# iPhone/Android thật → IP LAN của Metro (cần cùng Wi-Fi và API đang chạy).
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_API_PORT=4000

# Tùy chọn: ghi đè riêng một nền tảng, giữ nguyên URL kể cả localhost/adb reverse.
# EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:4000
# EXPO_PUBLIC_API_URL_IOS=http://192.168.1.169:4000
# EXPO_PUBLIC_API_URL_WEB=http://localhost:4000
# Production/native build: đặt URL API HTTPS thực tế, không dùng auto.
# Sau khi sửa: dừng Expo, chạy npm run start -w apps/mobile -- --clear --lan.
